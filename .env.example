# 环境变量配置
# 复制本文件为 .env 并填入你的 API Key

# LLM API Keys（至少填一个）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# 默认使用的模型
DEFAULT_MODEL=gpt-4o

# 视觉模型（看图时自动使用；普通对话仍走 DEFAULT_MODEL）
# 本地 Ollama 示例：VISION_MODEL=qwen2.5vl:7b / VISION_BASE_URL=http://localhost:11434/v1 / VISION_API_KEY=ollama
VISION_MODEL=qwen2.5vl:7b
VISION_BASE_URL=http://localhost:11434/v1
VISION_API_KEY=ollama

# Flare 数据目录（默认 ~/.flare）
FLARE_HOME=
